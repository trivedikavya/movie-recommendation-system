# Postgres connection string. In production this is auto-filled by the
# Vercel Postgres (Neon) integration. For local dev, create a free database
# at https://neon.tech or https://console.vercel.com/storage and paste its
# connection string here.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Set to "true" ONLY if your local network's DNS fails to resolve Neon's
# compute hostnames (some ISP/router resolvers do). Not needed on Vercel.
LOCAL_DNS_FIX="false"
